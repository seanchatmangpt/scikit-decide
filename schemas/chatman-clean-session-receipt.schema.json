{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seanchatman.dev/schemas/chatman-clean-session-receipt.schema.json",
  "title": "Chatman Clean-Session Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "task_identity",
    "task",
    "standing",
    "state_digest",
    "state",
    "broker_receipts",
    "actions",
    "replay_of"
  ],
  "properties": {
    "receipt_id": {"$ref": "#/$defs/digest"},
    "task_identity": {"$ref": "#/$defs/digest"},
    "task": {"$ref": "#/$defs/taskEnvelope"},
    "standing": {"$ref": "#/$defs/standing"},
    "state_digest": {"$ref": "#/$defs/digest"},
    "state": {"$ref": "#/$defs/sessionState"},
    "broker_receipts": {
      "type": "array",
      "items": {"$ref": "#/$defs/brokerReceipt"}
    },
    "actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"}
    },
    "replay_of": {
      "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "standing": {
      "anyOf": [
        {
          "enum": [
            "UNKNOWN",
            "PARTIAL_ALIVE",
            "ALIVE",
            "BLOCKED",
            "BUILD_BROKEN",
            "UNSUPPORTED"
          ]
        },
        {"type": "string", "pattern": "^REFUSED:.+$"}
      ]
    },
    "taskEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "base",
        "task",
        "acceptance",
        "constraints",
        "authority"
      ],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "base": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "acceptance": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "authority": {"type": "string"}
      }
    },
    "sessionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_identity",
        "stage",
        "attempted_routes",
        "route_evidence",
        "selected_route",
        "standing",
        "reason"
      ],
      "properties": {
        "task_identity": {"$ref": "#/$defs/digest"},
        "stage": {
          "enum": [
            "parse",
            "route",
            "admit",
            "diagnose_or_repair",
            "construct",
            "actuate",
            "observe_consequence",
            "verify",
            "receipt",
            "replay_or_hook",
            "standing"
          ]
        },
        "attempted_routes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "route_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/routeEvidence"}
        },
        "selected_route": {"type": ["string", "null"]},
        "standing": {"$ref": "#/$defs/standing"},
        "reason": {"type": ["string", "null"]}
      }
    },
    "routeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "outcome", "reason"],
      "properties": {
        "route": {"type": "string", "minLength": 1},
        "outcome": {
          "enum": [
            "SUCCESS",
            "FAILED",
            "BUILD_BROKEN",
            "BLOCKED",
            "UNSUPPORTED",
            "REFUSED"
          ]
        },
        "reason": {"type": ["string", "null"]}
      }
    },
    "actuationIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_identity",
        "route",
        "action",
        "payload",
        "replay_of"
      ],
      "properties": {
        "task_identity": {"$ref": "#/$defs/digest"},
        "route": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "payload": {"type": "object"},
        "replay_of": {
          "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        }
      }
    },
    "brokerReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "intent_id",
        "intent",
        "standing",
        "consequence",
        "reason"
      ],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/digest"},
        "intent_id": {"$ref": "#/$defs/digest"},
        "intent": {"$ref": "#/$defs/actuationIntent"},
        "standing": {"$ref": "#/$defs/standing"},
        "consequence": {"type": "object"},
        "reason": {"type": ["string", "null"]}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "lane", "route"],
      "properties": {
        "kind": {
          "enum": [
            "parse",
            "try_route",
            "classify_exhaustion",
            "admit",
            "diagnose_or_repair",
            "construct",
            "actuate",
            "observe_consequence",
            "verify",
            "receipt",
            "replay_or_hook"
          ]
        },
        "lane": {"enum": ["SELECT", "CONSTRUCT", "DO"]},
        "route": {"type": ["string", "null"]}
      }
    }
  }
}
