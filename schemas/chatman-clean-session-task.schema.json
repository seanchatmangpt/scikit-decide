{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seanchatman.dev/schemas/chatman-clean-session-task.schema.json",
  "title": "Chatman Clean-Session Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "base",
    "task",
    "acceptance",
    "routes"
  ],
  "properties": {
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "cost",
          "outcome"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "outcome": {
            "enum": [
              "SUCCESS",
              "FAILED",
              "BUILD_BROKEN",
              "BLOCKED",
              "UNSUPPORTED",
              "REFUSED"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "SUCCESS"
                }
              }
            },
            "then": {},
            "else": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
