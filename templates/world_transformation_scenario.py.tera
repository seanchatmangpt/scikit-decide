{% set obj_rows = sparql_results | filter(attribute="rowKind", value="objective") | filter(attribute="scenarioLabel", value=srow.scenarioLabel) -%}
{% set con_rows = sparql_results | filter(attribute="rowKind", value="constraint") | filter(attribute="scenarioLabel", value=srow.scenarioLabel) -%}

@dataclass(frozen=True)
class ScenarioMetadata_{{ srow.scenarioLabel | snake_case }}:
    """Real observed/objective/constraint values for `{{ srow.scenarioLabel }}`, threaded through as plain Python values (not only Atom labels)."""

    observations: dict[str, float] = field(default_factory=lambda: {
{%- for orow in obs_rows %}
        "{{ orow.metricName }}": {{ orow.metricValue }},
{%- endfor %}
    })
    objectives: tuple[dict, ...] = field(default_factory=lambda: (
{%- for jrow in obj_rows %}
        {"kind": "{{ jrow.objectiveKindLabel }}", "comparator": "{{ jrow.objectiveComparatorLabel | default(value='') }}", "threshold": {{ jrow.objectiveThreshold }}, "unit": "{{ jrow.objectiveUnit | default(value='') }}"},
{%- endfor %}
    ))
    constraints: tuple[dict, ...] = field(default_factory=lambda: (
{%- for crow in con_rows %}
        {"kind": "{{ crow.constraintKindLabel }}", "comparator": "{{ crow.constraintComparatorLabel | default(value='') }}", "threshold": {{ crow.constraintThreshold | default(value='None') }}, "unit": "{{ crow.constraintUnit | default(value='') }}", "note": "{{ crow.constraintNote | default(value='') }}"},
{%- endfor %}
    ))


def scenario_{{ srow.scenarioLabel | snake_case }}() -> ChoiceGraph:
    """World-transformation scenario `{{ srow.scenarioLabel }}`: observe -> infer_desired_state -> compute_delta -> select_transformation -> manufacture -> verify."""
    observe = Atom(label="observe_{{ srow.scenarioLabel | snake_case }}", consequence="READ")
    infer_desired_state = Atom(label="infer_desired_state_{{ srow.scenarioLabel | snake_case }}", consequence="PURE")
    compute_delta = Atom(label="compute_delta_{{ srow.scenarioLabel | snake_case }}", consequence="PURE")
    select_transformation = Atom(label="select_transformation_{{ srow.scenarioLabel | snake_case }}", consequence="PURE")
    manufacture = Atom(label="manufacture_{{ srow.scenarioLabel | snake_case }}", consequence="DO")
    verify = Atom(label="verify_{{ srow.scenarioLabel | snake_case }}", consequence="VERIFY")
    return ChoiceGraph(
        children=(Start(), End(), observe, infer_desired_state, compute_delta, select_transformation, manufacture, verify),
        edges=frozenset(
            [
                ChoiceGraphEdge(NodeId(0), NodeId(2)),
                ChoiceGraphEdge(NodeId(2), NodeId(3)),
                ChoiceGraphEdge(NodeId(3), NodeId(4)),
                ChoiceGraphEdge(NodeId(4), NodeId(5)),
                ChoiceGraphEdge(NodeId(5), NodeId(6)),
                ChoiceGraphEdge(NodeId(6), NodeId(7)),
                ChoiceGraphEdge(NodeId(7), NodeId(1)),
            ]
        ),
        start=0,
        end=1,
    )

{% endfor -%}
