# Mac
.DS_Store

# IDE
.*/
!.vuepress/
!.cursor/
# Project-scoped Claude Code tooling is part of the repo, not local config:
# CLAUDE.md @-imports .claude/rules/ and documents .claude/skills|agents/, so a
# clone without them gets a broken import. Local-only settings stay ignored.
!.claude/
.claude/settings.local.json

# Python
__pycache__/
.python-version

# Temp files
*.tmp

# Build files
build/
dist/

# Web docs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
docs/.vuepress/_state.json
docs/.vuepress/public/notebooks/
docs/*/_*.md
docs/notebooks/README.md
cpp/compile_commands.json
src/autofde_lab/hub/__autofde_lab_hub_cpp.*
TEMP_CGP/*

# OpenEvolve run artifacts (logs, per-generation programs, checkpoints).
# Regenerated by every run; committed once by accident via `git add -A` in
# f83c8a0 while parallel agents were mid-write. Build output, not source.
openevolve_output/
tests/solvers/python/openevolve/*/openevolve_output/
optuna-journal.log
TEMP_RLlib/
rddl_movies/

# SQLite WAL/SHM sidecars beside receipt ledgers. Transient runtime files that
# appear even on a mode=ro open; the ledger itself is the durable artifact.
*.sqlite3-shm
*.sqlite3-wal

# Real-time OCEL 2.0 telemetry generated per SREGym trial (scripts/
# run_representative_sample.sh, src/autofde_lab/ocel/live_flush.py). One
# .ocel2.sqlite per problem, reproducible by re-running the batch -- the
# tooling that produces/reads them is tracked, the generated data is not.
docs/ocel/sregym/*.ocel2.sqlite

# Local secrets (GROQ_API_KEY etc.) -- never committed
.env
