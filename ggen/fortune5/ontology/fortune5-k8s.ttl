f5:o-enterprise-enterprise-04 a f5:Option ; f5:optionName "enterprise-04" ; f5:optionOrder 40 .
f5:o-enterprise-enterprise-05 a f5:Option ; f5:optionName "enterprise-05" ; f5:optionOrder 50 .

