@prefix arch: <urn:autofde-lab:architecture:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

arch:DiagramShape
    a sh:NodeShape ;
    sh:targetClass arch:Diagram ;
    sh:property [ sh:path arch:sourcePath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path arch:sourceDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path arch:diagramKind ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path arch:elementCount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path arch:relationshipCount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] .

arch:ElementShape
    a sh:NodeShape ;
    sh:targetClass arch:ArchitectureElement ;
    sh:property [ sh:path arch:belongsToDiagram ; sh:minCount 1 ; sh:maxCount 1 ; sh:class arch:Diagram ] ;
    sh:property [ sh:path arch:localIdentifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

arch:RelationshipShape
    a sh:NodeShape ;
    sh:targetClass arch:Relationship ;
    sh:property [ sh:path arch:belongsToDiagram ; sh:minCount 1 ; sh:maxCount 1 ; sh:class arch:Diagram ] ;
    sh:property [ sh:path arch:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:class arch:ArchitectureElement ] ;
    sh:property [ sh:path arch:target ; sh:minCount 1 ; sh:maxCount 1 ; sh:class arch:ArchitectureElement ] .

arch:MessageShape
    a sh:NodeShape ;
    sh:targetClass arch:Message ;
    sh:property [ sh:path arch:sequenceIndex ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .
