@prefix afl: <urn:autofde-lab:> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:autofde-lab:ontology:authority>
    a owl:Ontology ;
    dcterms:title "AutoFDE Lab authority-boundary vocabulary" ;
    dcterms:description "Describes explicit authority required by consequential transitions. This vocabulary models the boundary contract; it does not grant autofde-lab ambient authority to actuate." ;
    dcterms:created "2026-08-08"^^xsd:date .

afl:AuthorityEnvelope a owl:Class ; rdfs:subClassOf odrl:Policy ;
    rdfs:isDefinedBy <urn:autofde-lab:ontology:authority> ;
    rdfs:label "Authority envelope" ; rdfs:comment "A bounded grant associated with an exact subject, capability, scope, and consequential transition." .
afl:Actuation a owl:Class , prov:Activity ;
    rdfs:isDefinedBy <urn:autofde-lab:ontology:authority> ;
    rdfs:label "Actuation" ; rdfs:comment "A consequential transition in an external or simulated world. Capability to perform it is not authority to perform it." .

afl:authoritySubject a owl:ObjectProperty ; rdfs:domain afl:AuthorityEnvelope ; rdfs:range prov:Agent ; rdfs:label "authority subject" .
afl:authorityCapability a owl:ObjectProperty ; rdfs:domain afl:AuthorityEnvelope ; rdfs:range afl:Capability ; rdfs:label "authority capability" .
afl:authorizesActuation a owl:ObjectProperty ; rdfs:domain afl:AuthorityEnvelope ; rdfs:range afl:Actuation ; rdfs:label "authorizes actuation" .
afl:realizesCommitment a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain afl:Actuation ; rdfs:range afl:POWLCommitment ; rdfs:label "realizes commitment" .
afl:authorizedBy a owl:ObjectProperty , owl:FunctionalProperty ; owl:inverseOf afl:authorizesActuation ; rdfs:domain afl:Actuation ; rdfs:range afl:AuthorityEnvelope ; rdfs:label "authorized by" .
afl:exercisesCapability a owl:ObjectProperty ; rdfs:domain afl:Actuation ; rdfs:range afl:Capability ; rdfs:label "exercises capability" .
afl:actsOnEnvironment a owl:ObjectProperty ; rdfs:domain afl:Actuation ; rdfs:range afl:Environment ; rdfs:label "acts on environment" .
afl:validFrom a owl:DatatypeProperty ; rdfs:domain afl:AuthorityEnvelope ; rdfs:range xsd:dateTime ; rdfs:label "valid from" .
afl:validUntil a owl:DatatypeProperty ; rdfs:domain afl:AuthorityEnvelope ; rdfs:range xsd:dateTime ; rdfs:label "valid until" .
afl:singleUse a owl:DatatypeProperty ; rdfs:domain afl:AuthorityEnvelope ; rdfs:range xsd:boolean ; rdfs:label "single use" .
