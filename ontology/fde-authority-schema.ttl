@prefix skd: <urn:skdecide:capability:> .
@prefix skdt: <urn:skdecide:term:> .
@prefix fde: <urn:skdecide:fde:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# HAND-AUTHORED T-BOX (vocabulary schema). NOT generated, and NOT a standing claim set.
#
# This file is different IN KIND from ontology/autofde-lab-capabilities.ttl:
#
#   autofde-lab-capabilities.ttl  A-BOX  what is true right now, in this environment.
#                              GENERATED by skdecide.fabric.ontology from entry points
#                              + a live import probe. Its credibility rests on the probe
#                              being the SAME ACT as the use. Hand-editing it is a defect
#                              and is blocked by .claude/hooks/no-hand-edit-generated.sh.
#
#   fde-authority-schema.ttl   T-BOX  what KINDS of thing exist and how they relate.
#                              This file. Hand-authoring a vocabulary is legitimate;
#                              hand-authoring a standing claim is exactly what the
#                              generator exists to prevent.
#
# Consequently: every skdt:standing below is UNSUPPORTED or UNKNOWN. NOTHING here is ALIVE.
# No crown stage has run for any capability defined in this file, and no component in the
# portfolio computes organizationalStanding today. A term existing here is not evidence that
# anything implements it -- see docs/ecosystem-standing.md RP-8.
#
# Turtle subset deliberately narrow so this repo's own parsers can read it: one statement
# per line, declared-prefix or absolute subjects, no blank nodes, no RDF collections, no
# multi-line literals.

##
## Standing dimensions -- first-class terms, not adjectives
##

<urn:skdecide:term:technicalStanding> a skdt:StandingDimension ;
    skdt:identifier "technicalStanding" ;
    rdfs:label "technical standing" ;
    rdfs:comment "Whether the artifact was manufactured, verified and replayed as specified. Every existing standing claim in docs/STATUS.md and docs/ecosystem-standing.md is a claim on THIS dimension only." ;
    skdt:standing "UNKNOWN" ;
    skdt:evidence "dimension is newly named this session; no component labels its standing claims with a dimension yet" .

<urn:skdecide:term:organizationalStanding> a skdt:StandingDimension ;
    skdt:identifier "organizationalStanding" ;
    rdfs:label "organizational standing" ;
    rdfs:comment "Whether an accountable customer authority validated the model, granted the bounded transition, accepted the verified consequence, assigned operating ownership, and authorized any irreversible sunset. NOT computed by any component today." ;
    skdt:standing "UNSUPPORTED" ;
    skdt:evidence "no component computes this dimension generally; the FDE authority rail (RP-8) is unbuilt. One point in the real code already separates it: decision-engine.py's release_admitted (technical) closes independently of sunset_admitted (organizational), measured this session" .

<urn:skdecide:term:enterpriseStanding> a skdt:StandingDimension ;
    skdt:identifier "enterpriseStanding" ;
    rdfs:label "enterprise standing" ;
    rdfs:comment "ALIVE only when technicalStanding AND organizationalStanding are both admitted. Never derivable from technical evidence alone. Since organizationalStanding is UNSUPPORTED, enterpriseStanding is currently unreachable by construction." ;
    skdt:standing "UNSUPPORTED" ;
    skdt:evidence "conjunction of two dimensions, one of which is UNSUPPORTED; nothing computes the conjunction" ;
    skdt:requiresDimension <urn:skdecide:term:technicalStanding> ;
    skdt:requiresDimension <urn:skdecide:term:organizationalStanding> .

##
## Entities
##

<urn:skdecide:fde:ForwardDeployedArchitect> a skdt:Entity ;
    skdt:identifier "ForwardDeployedArchitect" ;
    rdfs:label "Forward-Deployed Architect" ;
    rdfs:comment "The role that bridges customer reality and the technical chain. Compiles a customer model as a falsifiable hypothesis and presents it for validation. Holds NO customer authority: may not invent authority, self-admit observations, or self-certify artifacts." .

<urn:skdecide:fde:CustomerOrganization> a skdt:Entity ;
    skdt:identifier "CustomerOrganization" ;
    rdfs:label "customer organization" ;
    rdfs:comment "The accountable enterprise whose reality the compiled model is a hypothesis about. Not a deployment target and not a user account." .

<urn:skdecide:fde:CustomerAuthority> a skdt:Entity ;
    skdt:identifier "CustomerAuthority" ;
    rdfs:label "customer authority" ;
    rdfs:comment "A NAMED holder of one or more decision rights inside the CustomerOrganization. A boolean flag in a manifest is not a CustomerAuthority -- see docs/ecosystem-standing.md on customer_authorized_retirement." .

<urn:skdecide:fde:OrganizationalRole> a skdt:Entity ;
    skdt:identifier "OrganizationalRole" ;
    rdfs:label "organizational role" ;
    rdfs:comment "A position within the CustomerOrganization to which decision rights attach. A role is not itself an authority; a person or body holding the role is." .

<urn:skdecide:fde:DecisionRight> a skdt:Entity ;
    skdt:identifier "DecisionRight" ;
    rdfs:label "decision right" ;
    rdfs:comment "A specific, scoped power to decide -- e.g. to admit an observation, to permit a bounded transition, to retire a predecessor. Rights are non-interchangeable: holding one never implies holding another." .

<urn:skdecide:fde:AuthorityGrant> a skdt:Entity ;
    skdt:identifier "AuthorityGrant" ;
    rdfs:label "authority grant" ;
    rdfs:comment "A bounded, attributable conversion of a DecisionRight into machine-enforceable permission. Must name the authority, the scope conditions, the environment bound, the evidence reviewed, and a timestamp. Enforcement belongs to mfw's broker, never to this repository." .

<urn:skdecide:fde:CompiledCustomerModel> a skdt:Entity ;
    skdt:identifier "CompiledCustomerModel" ;
    rdfs:label "compiled customer model" ;
    rdfs:comment "The FDE's structured hypothesis about customer operations, obligations and constraints. It is a hypothesis pending customer validation, NOT admitted knowledge." .

<urn:skdecide:fde:AdmissionDecision> a skdt:Entity ;
    skdt:identifier "AdmissionDecision" ;
    rdfs:label "admission decision" ;
    rdfs:comment "An accountable act converting an observation or compiled model into admitted knowledge. The FDE presents; the customer authority admits." .

<urn:skdecide:fde:BusinessPostcondition> a skdt:Entity ;
    skdt:identifier "BusinessPostcondition" ;
    rdfs:label "business postcondition" ;
    rdfs:comment "The operating obligation a technical consequence must satisfy for the consequence to matter. Agreed in advance. A green receipt satisfies no BusinessPostcondition by itself." .

<urn:skdecide:fde:AdoptionDecision> a skdt:Entity ;
    skdt:identifier "AdoptionDecision" ;
    rdfs:label "adoption decision" ;
    rdfs:comment "The customer operating owner's decision to take up a manufactured capability into actual operation. Deployment, file creation and receipt verification are NOT adoption." .

<urn:skdecide:fde:OperatingOwner> a skdt:Entity ;
    skdt:identifier "OperatingOwner" ;
    rdfs:label "operating owner" ;
    rdfs:comment "The named party accountable for running the adopted capability afterwards. Absence of an assigned OperatingOwner leaves organizationalStanding UNKNOWN regardless of technical evidence." .

<urn:skdecide:fde:SunsetAuthorization> a skdt:Entity ;
    skdt:identifier "SunsetAuthorization" ;
    rdfs:label "sunset authorization" ;
    rdfs:comment "Explicit authority for an irreversible retirement. Distinct from an AdoptionDecision in both direction and issuer; adopting a successor never authorizes retiring a predecessor." .

##
## Capabilities -- NONE ALIVE. No crown stage has run for any of these.
##

<urn:skdecide:fde:capability/CompileCustomerModel> a skdt:FdeCapability ;
    skdt:identifier "CompileCustomerModel" ;
    rdfs:label "compile customer model" ;
    rdfs:comment "Produce a CompiledCustomerModel from customer observation, as a falsifiable hypothesis carrying its own refutation conditions." ;
    skdt:standing "UNSUPPORTED" ;
    skdt:evidence "no module, binary or test in any portfolio repo produces a CompiledCustomerModel; the term is introduced by this file" .

<urn:skdecide:fde:capability/ValidateCustomerObservation> a skdt:FdeCapability ;
    skdt:identifier "ValidateCustomerObservation" ;
    rdfs:label "validate customer observation" ;
    rdfs:comment "Determine whether an observation is materially complete for the decision it will support. Customer-relative and not answerable by the system." ;
    skdt:standing "UNSUPPORTED" ;
    skdt:evidence "materially-complete is a customer-relative predicate; no component accepts customer validation input" .

<urn:skdecide:fde:capability/AdmitCustomerKnowledge> a skdt:FdeCapability ;
    skdt:identifier "AdmitCustomerKnowledge" ;
    rdfs:label "admit customer knowledge" ;
    rdfs:comment "Convert a validated observation into admitted knowledge under an AdmissionDecision. The FDE may present but must never self-admit." ;
    skdt:standing "UNSUPPORTED" ;
    skdt:evidence "mfw admits technical artifacts against digests; no admission path takes a customer authority as input" .

<urn:skdecide:fde:capability/BindOrganizationalAuthority> a skdt:FdeCapability ;
    skdt:identifier "BindOrganizationalAuthority" ;
    rdfs:label "bind organizational authority" ;
    rdfs:comment "Convert a DecisionRight into a bounded AuthorityGrant a broker can enforce. scikit-decide may at most COMPILE and CHECK such an envelope; minting and enforcement belong to mfw's broker." ;
    skdt:standing "UNSUPPORTED" ;
    skdt:evidence "mfw's ActuationRequest carries model/proof digests and an occurrence, not a named organizational authority; no grant type exists" .

<urn:skdecide:fde:capability/MapActivityToCustomerOperation> a skdt:FdeCapability ;
    skdt:identifier "MapActivityToCustomerOperation" ;
    rdfs:label "map activity to customer operation" ;
    rdfs:comment "Bind a POWL activity to a real operation in the customer's environment, including whether this system may touch that production environment at all." ;
    skdt:standing "UNKNOWN" ;
    skdt:evidence "the technical half of this mapping is the open G1+G3 gap in docs/ecosystem-standing.md; the customer-environment half has never been examined, so status is unobserved rather than known-absent" .

<urn:skdecide:fde:capability/PresentConsequenceEvidence> a skdt:FdeCapability ;
    skdt:identifier "PresentConsequenceEvidence" ;
    rdfs:label "present consequence evidence" ;
    rdfs:comment "Present independently verified evidence that a manufactured consequence satisfies the agreed BusinessPostcondition -- not merely that an artifact was produced." ;
    skdt:standing "UNKNOWN" ;
    skdt:evidence "receipt verification exists in ggen and mfw, but no component relates a receipt to a BusinessPostcondition; whether existing evidence formats suffice is unobserved" .

<urn:skdecide:fde:capability/AdoptManufacturedCapability> a skdt:FdeCapability ;
    skdt:identifier "AdoptManufacturedCapability" ;
    rdfs:label "adopt manufactured capability" ;
    rdfs:comment "Record an AdoptionDecision and assign an OperatingOwner. Whether the organization will adopt is not a predicate the system can evaluate." ;
    skdt:standing "UNSUPPORTED" ;
    skdt:evidence "no adoption record, operating-owner field, or acceptance path exists anywhere in the portfolio" .

<urn:skdecide:fde:capability/AuthorizePredecessorSunset> a skdt:FdeCapability ;
    skdt:identifier "AuthorizePredecessorSunset" ;
    rdfs:label "authorize predecessor sunset" ;
    rdfs:comment "Obtain an attributable SunsetAuthorization for an irreversible retirement. The existing gate's SHAPE is right and must be preserved and invoked, never replaced by a local simulation; what is missing is that its boolean has no referent." ;
    skdt:standing "UNKNOWN" ;
    skdt:evidence "executed this session: ~/ggen-legacy/appliance/bin/decision-engine.py driven over four manifests with technical evidence held constant and green; release_admitted true in all four, sunset_admitted true only for boolean true, false for absent/string/false. The gate works and fail-closes; the flag is a bare boolean with no named authority, predecessor identity, replacement identity, reviewed evidence set, timestamp or scope conditions" .

##
## Relations
##

<urn:skdecide:term:compiledBy> a skdt:Relation ;
    skdt:identifier "compiledBy" ;
    rdfs:comment "CompiledCustomerModel -> ForwardDeployedArchitect. Records who authored the hypothesis; confers no authority over it." .

<urn:skdecide:term:validatedBy> a skdt:Relation ;
    skdt:identifier "validatedBy" ;
    rdfs:comment "CompiledCustomerModel -> CustomerAuthority. Validation is the customer's act, never the compiler's." .

<urn:skdecide:term:admittedBy> a skdt:Relation ;
    skdt:identifier "admittedBy" ;
    rdfs:comment "CompiledCustomerModel -> AdmissionDecision. Distinct from validatedBy: validation says the model is right, admission says it may be relied on." .

<urn:skdecide:term:grantsDecisionRight> a skdt:Relation ;
    skdt:identifier "grantsDecisionRight" ;
    rdfs:comment "OrganizationalRole -> DecisionRight." .

<urn:skdecide:term:authorizesCapability> a skdt:Relation ;
    skdt:identifier "authorizesCapability" ;
    rdfs:comment "AuthorityGrant -> FdeCapability. A grant authorizes specific capabilities, never a class of them." .

<urn:skdecide:term:boundedToEnvironment> a skdt:Relation ;
    skdt:identifier "boundedToEnvironment" ;
    rdfs:comment "AuthorityGrant -> environment identifier. An unbounded grant is not a grant; may this system touch THAT environment is a separate question from may it act at all." .

<urn:skdecide:term:requiresPostcondition> a skdt:Relation ;
    skdt:identifier "requiresPostcondition" ;
    rdfs:comment "AuthorityGrant or AdoptionDecision -> BusinessPostcondition. Agreed before the work, not selected afterwards to fit the result." .

<urn:skdecide:term:verifiedBy> a skdt:Relation ;
    skdt:identifier "verifiedBy" ;
    rdfs:comment "technical consequence -> independent verifier. The producer's own claim never satisfies this." .

<urn:skdecide:term:acceptedBy> a skdt:Relation ;
    skdt:identifier "acceptedBy" ;
    rdfs:comment "technical consequence -> CustomerAuthority. Acceptance is organizational; verification is technical. Neither implies the other." .

<urn:skdecide:term:ownedBy> a skdt:Relation ;
    skdt:identifier "ownedBy" ;
    rdfs:comment "adopted capability -> OperatingOwner." .

<urn:skdecide:term:authorizesSunsetOf> a skdt:Relation ;
    skdt:identifier "authorizesSunsetOf" ;
    rdfs:comment "SunsetAuthorization -> predecessor identity. Must name a specific predecessor and a specific verified replacement; a blanket authorization is not one." .

<urn:skdecide:term:requiresDimension> a skdt:Relation ;
    skdt:identifier "requiresDimension" ;
    rdfs:comment "StandingDimension -> StandingDimension. Used only by enterpriseStanding, which requires both others admitted." .
