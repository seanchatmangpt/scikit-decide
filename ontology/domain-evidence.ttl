# --- tai_v30_1_1: works with the default zero-arg construction + Astar path,
# no factory needed -- confirmed this session (goal_reached=True, plan_length=12).

afl:domain_tai_v30_1_1 a afl:DomainEvidenceSpec ;
    afl:domainName "tai_v30_1_1" ;
    afl:pythonModulePath "autofde_lab.hub.domain.tai_v30_1_1.tai_v30_1_1" ;
    afl:domainClassName "TAIForwardDeploymentDomain" ;
    afl:bridgeModulePath "" ;
    afl:bridgeClassName "" ;
    afl:goalCheckExpr "state.standing == True" ;
    afl:verifyMode "fresh-instance-replay" ;
    afl:evidenceOutPath "docs/evidence/tai_v30_1_1/domain-evidence-episode.ocel.json" ;
    afl:hasCapability afl:domain_tai_v30_1_1_cap_1 .

afl:domain_tai_v30_1_1_cap_1 a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "compile_enterprise" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "not state.enterprise_compiled" .


# --- rcpsp: real closure via DOSolver+CpSatRcpspSolver (OR-Tools CP-SAT,
# no MiniZinc), NOT the registered Astar solver which genuinely hangs on
# real PSPLIB instances (confirmed this session, two real timeouts). Custom
# episode function (_run_rcpsp_episode) since DOSolver's construction/solve/
# rollout shape differs entirely from the Astar-goal-reaching family.

afl:domain_rcpsp a afl:DomainEvidenceSpec ;
    afl:domainName "rcpsp" ;
    afl:pythonModulePath "autofde_lab.hub.domain.rcpsp.rcpsp_sk" ;
    afl:domainClassName "RCPSP" ;
    afl:bridgeModulePath "" ;
    afl:bridgeClassName "" ;
    afl:goalCheckExpr "state.tasks_complete == state.task_ids  # all 32 j301_1.sm tasks complete" ;
    afl:verifyMode "independent-resolve" ;
    afl:evidenceOutPath "docs/evidence/rcpsp/domain-evidence-episode.ocel.json" ;
    afl:hasCapability afl:domain_rcpsp_cap_1 ;
    afl:hasSolverCandidate afl:domain_rcpsp_solver_1, afl:domain_rcpsp_solver_2 .

afl:domain_rcpsp_cap_1 a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "start_task(task_id, mode)" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "precedence + resource constraints satisfied (SGS_PRECEDENCE policy)" .

# Real, proven fallback order: registered Astar genuinely hangs indefinitely
# on real PSPLIB instances (confirmed this session, two real timeouts) --
# ordered first so the meta-planner's own timeout is what rules it out, not
# prior human knowledge. do-solver-cpsat is the real, proven fix (75-step
# plan, 32/32 tasks complete).
afl:domain_rcpsp_solver_1 a afl:SolverCandidate ;
    afl:candidateOrder 1 ;
    afl:solverStrategy "astar-plain" ;
    afl:solverTimeoutSeconds 20 .

afl:domain_rcpsp_solver_2 a afl:SolverCandidate ;
    afl:candidateOrder 2 ;
    afl:solverStrategy "do-solver-cpsat" ;
    afl:solverTimeoutSeconds 60 .


# --- mastermind: real closure via one-guess solve (state exposes the
# hidden solution directly to the domain object, even though the
# codebreaker's observation does not) -- a GoalPOMDPDomain, not
# Astar-solvable. Custom episode function since the construction/solve
# shape (stochastic initial-state sampling, no Astar) differs entirely
# from the deterministic-planning family.

afl:domain_mastermind a afl:DomainEvidenceSpec ;
    afl:domainName "mastermind" ;
    afl:pythonModulePath "autofde_lab.hub.domain.mastermind.mastermind" ;
    afl:domainClassName "MasterMind" ;
    afl:bridgeModulePath "" ;
    afl:bridgeClassName "" ;
    afl:goalCheckExpr "score == Score(total_bulls=n_positions, total_cows=0)" ;
    afl:verifyMode "independent-resolve" ;
    afl:evidenceOutPath "docs/evidence/mastermind/domain-evidence-episode.ocel.json" ;
    afl:hasCapability afl:domain_mastermind_cap_1 .

afl:domain_mastermind_cap_1 a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "guess(row)" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "true (UnrestrictedActions -- any row in the enumerable action space is always applicable)" .


