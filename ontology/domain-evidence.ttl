    afl:domainClassName "RDDLDomain" ;
    afl:bridgeModulePath "" ;
    afl:bridgeClassName "" ;
    afl:goalCheckExpr "N/A -- stochastic RLDomain (pyRDDLGym CartPole_Continuous_gym), no deterministic goal; closed via seeded-trajectory-replay (seeded RNG, bitwise-identical replay proven)" ;
    afl:verifyMode "seeded-trajectory-replay" ;
