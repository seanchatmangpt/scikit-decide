    afl:hasSolverCandidate afl:domain_simple_grid_world_solver_1, afl:domain_simple_grid_world_solver_2 .

afl:domain_simple_grid_world_cap_1 a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "up|down|left|right" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "true (UnrestrictedActions, wall-clamped at grid edges)" .

# Real, proven second candidate: BFWS independently reproduces the
# identical Manhattan-optimal 18-step goal Astar already proved.
afl:domain_simple_grid_world_solver_1 a afl:SolverCandidate ;
    afl:candidateOrder 1 ;
    afl:solverStrategy "astar-plain" ;
    afl:solverTimeoutSeconds 15 .

afl:domain_simple_grid_world_solver_2 a afl:SolverCandidate ;
    afl:candidateOrder 2 ;
    afl:solverStrategy "bfws-state-features" ;
    afl:solverTimeoutSeconds 15 .

afl:domain_rock_paper_scissors a afl:DomainEvidenceSpec ;
