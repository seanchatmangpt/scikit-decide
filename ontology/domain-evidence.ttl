# Real, proven second candidate this round: LRTAstar independently
# reproduces the identical 58-step optimal goal state Astar already proved
# (utils.load_registered_solver("LRTAstar") resolves to
# autofde_lab.hub.solver.lrtdp.lrtdp.LRTAstar). astar-plain kept first
# (already the domain's proven-working mechanism, no reason to demote it).
afl:domain_maze_solver_1 a afl:SolverCandidate ;
    afl:candidateOrder 1 ;
    afl:solverStrategy "astar-plain" ;
    afl:solverTimeoutSeconds 30 .

afl:domain_maze_solver_2 a afl:SolverCandidate ;
    afl:candidateOrder 2 ;
    afl:solverStrategy "lrtastar-plain" ;
    afl:solverTimeoutSeconds 30 .

# Verifier-of-verifiers pilot: maze declares 2 candidate verify strategies in
# priority order. fresh-instance-replay first (cheap: replay the recorded
# plan on a brand-new Maze instance, check goal + state match -- already the
# domain's real proven mechanism). independent-resolve second, as the real
# fallback: an entirely independent from-scratch Astar re-solve of a FRESH
# domain instance, checking only that it too reaches goal -- a genuinely
# different verification mechanism (doesn't touch the recorded plan at all),
# proven this pass by real execution (see the runner's _run_verify_portfolio
# and this domain's real episode run).
afl:domain_maze_verify_1 a afl:VerifyCandidate ;
    afl:verifyCandidateOrder 1 ;
    afl:verifyStrategy "fresh-instance-replay" ;
    afl:verifyTimeoutSeconds 15 .

afl:domain_maze_verify_2 a afl:VerifyCandidate ;
    afl:verifyCandidateOrder 2 ;
    afl:verifyStrategy "independent-resolve" ;
    afl:verifyTimeoutSeconds 30 .

afl:domain_maze_cap_1 a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "up|down|left|right" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "true" .

afl:domain_pddl a afl:DomainEvidenceSpec ;
    afl:domainName "pddl" ;
    afl:pythonModulePath "autofde_lab.hub.domain.pddl.domain" ;
    afl:domainClassName "PDDLDomain" ;
    afl:bridgeModulePath "" ;
    afl:bridgeClassName "" ;
    afl:goalCheckExpr "self._goal_checker.is_goal(s.to_cpp())  # C++ CppGoalChecker compiled from the loaded PDDL domain/problem file; for the proven fixture (blocks-3-0) the goal is 'on(b, c)'" ;
    afl:verifyMode "fresh-instance-replay" ;
    afl:evidenceOutPath "docs/evidence/pddl/domain-evidence-episode.ocel.json" ;
    afl:hasCapability afl:domain_pddl_cap_1 .

afl:domain_pddl_cap_1 a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "PDDLAction  # grounded action instance, e.g. (pick-up|stack|...) — dynamically enumerated per problem file, not a fixed constant" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "self._aops_gen.get_applicable_actions(memory.to_cpp())  # C++ delete-relaxation-free applicability generator over the PDDL task's compiled action schema; no static Python precondition expression exists in this module" .


