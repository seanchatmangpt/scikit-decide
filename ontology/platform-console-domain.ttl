# -- Actions --------------------------------------------------------------

# castle.verb.inventory-components -- reversible, castle-brokered.
ex:action-castle-inventory-components a pd:Action ;
    pd:actionName "castle-inventory-components" ;
    pd:hasParameter [ pd:parameterName "x" ; pd:parameterIndex 0 ] ;
    pd:precondition
        [ a pd:Atom ; pd:ofPredicate "exists" ;
          pd:hasArgument [ pd:argument "x" ; pd:argumentIndex 0 ] ] ;
    pd:effect
        [ a pd:Atom ; pd:ofPredicate "components-inventoried" ;
          pd:hasArgument [ pd:argument "x" ; pd:argumentIndex 0 ] ] .

# castle.verb.inventory-goals -- reversible, castle-brokered.
ex:action-castle-inventory-goals a pd:Action ;
    pd:actionName "castle-inventory-goals" ;
    pd:hasParameter [ pd:parameterName "x" ; pd:parameterIndex 0 ] ;
    pd:precondition
        [ a pd:Atom ; pd:ofPredicate "exists" ;
          pd:hasArgument [ pd:argument "x" ; pd:argumentIndex 0 ] ] ;
    pd:effect
        [ a pd:Atom ; pd:ofPredicate "goals-inventoried" ;
          pd:hasArgument [ pd:argument "x" ; pd:argumentIndex 0 ] ] .

# castle.verb.fortune5-requirements -- reversible, castle-brokered.
ex:action-castle-fortune5-requirements a pd:Action ;
    pd:actionName "castle-fortune5-requirements" ;
    pd:hasParameter [ pd:parameterName "x" ; pd:parameterIndex 0 ] ;
    pd:precondition
        [ a pd:Atom ; pd:ofPredicate "exists" ;
          pd:hasArgument [ pd:argument "x" ; pd:argumentIndex 0 ] ] ;
    pd:effect
        [ a pd:Atom ; pd:ofPredicate "fortune5-requirements-listed" ;
          pd:hasArgument [ pd:argument "x" ; pd:argumentIndex 0 ] ] .

# org.delete -- IRREVERSIBLE, destructive. Approval-gated.
#   (Negated preconditions are unsupported without the PDDL
#   :negative-preconditions requirement, which this untyped :strips
#   domain deliberately does not declare -- matching rdf_domain.py's
#   existing to_pddl(), left unmodified -- so 'not frozen' is enforced
#   structurally instead: nothing in this fixture ever asserts frozen
#   for the irreversible-refused problem's object, and the real gate
#   this test proves is 'approved' being absent.)
ex:action-org-delete a pd:Action ;
    pd:actionName "org-delete" ;
    pd:hasParameter [ pd:parameterName "x" ; pd:parameterIndex 0 ] ;
    pd:precondition
        [ a pd:Atom ; pd:ofPredicate "org-exists" ;
          pd:hasArgument [ pd:argument "x" ; pd:argumentIndex 0 ] ],
        [ a pd:Atom ; pd:ofPredicate "approved" ;
          pd:hasArgument [ pd:argument "x" ; pd:argumentIndex 0 ] ] ;
    pd:effect
        [ a pd:NegatedAtom ; pd:ofPredicate "org-exists" ;
          pd:hasArgument [ pd:argument "x" ; pd:argumentIndex 0 ] ] .

