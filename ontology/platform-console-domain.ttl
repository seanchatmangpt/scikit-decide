# Support action: brings a resource to deployed=true so deployment-
#   dependent actions (dr-failover, patch-deployment-replicas,
#   deployment-quarantine, create-backup-job) have a reachable
#   precondition. Not one of the ~30 console capabilities itself.
ex:action-deploy a pd:Action ;
    pd:actionName "deploy" ;
    pd:hasParameter [ pd:parameterName "x" ; pd:parameterIndex 0 ] ;
    pd:precondition
        [ a pd:Atom ; pd:ofPredicate "org-exists" ;
          pd:hasArgument [ pd:argument "x" ; pd:argumentIndex 0 ] ] ;
    pd:effect
        [ a pd:Atom ; pd:ofPredicate "deployed" ;
          pd:hasArgument [ pd:argument "x" ; pd:argumentIndex 0 ] ] .

# Support action: brings a resource to frozen=true so freeze.override
#   has a reachable precondition. Not one of the ~30 console
#   capabilities itself.
ex:action-freeze a pd:Action ;
    pd:actionName "freeze" ;
    pd:hasParameter [ pd:parameterName "x" ; pd:parameterIndex 0 ] ;
    pd:precondition
        [ a pd:Atom ; pd:ofPredicate "org-exists" ;
          pd:hasArgument [ pd:argument "x" ; pd:argumentIndex 0 ] ] ;
    pd:effect
        [ a pd:Atom ; pd:ofPredicate "frozen" ;
          pd:hasArgument [ pd:argument "x" ; pd:argumentIndex 0 ] ] .

# -- Problems ---------------------------------------------------------
# Three real goal states, matching the task's three required scenarios:
#  1. ex:problem-reversible     -- quota.override, a reversible capability.
#  2. ex:problem-gated          -- castle.verb.schedule, an approval-gated
#     capability, reached only via the "approved" precondition being true.
#  3. ex:problem-irreversible-refused -- org.delete, an IRREVERSIBLE
#     capability, whose goal (org-exists false) is DELIBERATELY UNREACHABLE
#     because "approved" is never asserted for the target object -- proving
#     the precondition gate correctly refuses (Astar returns EXIT_NO_PLAN),
#     never that the destructive action ran.

ex:problem-reversible a pd:Problem ;
    pd:problemName "platform-console-reversible" ;
    pd:forDomain ex:domain ;
    pd:hasObject [ pd:objectName "res1" ] ;
    pd:init
        [ a pd:Atom ; pd:ofPredicate "org-exists" ;
          pd:hasArgument [ pd:argument "res1" ; pd:argumentIndex 0 ] ] ,
        [ a pd:Atom ; pd:ofPredicate "approved" ;
          pd:hasArgument [ pd:argument "res1" ; pd:argumentIndex 0 ] ] ;
    pd:goal
        [ a pd:Atom ; pd:ofPredicate "quota-hard-set" ;
          pd:hasArgument [ pd:argument "res1" ; pd:argumentIndex 0 ] ] .

ex:problem-gated a pd:Problem ;
    pd:problemName "platform-console-gated" ;
    pd:forDomain ex:domain ;
    pd:hasObject [ pd:objectName "res2" ] ;
    pd:init
        [ a pd:Atom ; pd:ofPredicate "org-exists" ;
          pd:hasArgument [ pd:argument "res2" ; pd:argumentIndex 0 ] ] ,
        [ a pd:Atom ; pd:ofPredicate "approved" ;
          pd:hasArgument [ pd:argument "res2" ; pd:argumentIndex 0 ] ] ;
    pd:goal
        [ a pd:Atom ; pd:ofPredicate "scheduled" ;
          pd:hasArgument [ pd:argument "res2" ; pd:argumentIndex 0 ] ] .

ex:problem-irreversible-refused a pd:Problem ;
    pd:problemName "platform-console-irreversible-refused" ;
    pd:forDomain ex:domain ;
    pd:hasObject [ pd:objectName "res3" ] ;
    pd:init
        [ a pd:Atom ; pd:ofPredicate "org-exists" ;
          pd:hasArgument [ pd:argument "res3" ; pd:argumentIndex 0 ] ] ;
    pd:goal
        [ a pd:NegatedAtom ; pd:ofPredicate "org-exists" ;
          pd:hasArgument [ pd:argument "res3" ; pd:argumentIndex 0 ] ] .

