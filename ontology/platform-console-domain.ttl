@prefix pd: <urn:autofde-lab:planning-domain:> .
@prefix ex: <urn:autofde-lab:planning-domain:platform-console:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Real ontology/platform-console-domain.ttl fixture: all ~30 fabric
# capabilities (see this repo's parallel authority-workflow session context)
# encoded as pd:Action individuals in the pd: vocabulary defined by
# ontology/rdf-planning-domain.ttl, compiled unmodified by
# autofde_lab.fabric.rdf_domain.compile_rdf_to_pddl_files and solved
# unmodified by autofde_lab.fabric.pddl_engine.solve_to_plan_file.
#
# Predicate names are the console-snapshot-route's predicate vocabulary as
# named in the task prompt (deployed, frozen, freeze-override-approved,
# org-exists, quota-hard-set, reservation-active, partner-exists, etc).
# INTEGRATION NOTE: the console-snapshot route is being built in parallel by
# a sibling agent in this session; its exact returned predicate names were not
# visible when this fixture was authored, so the names below are the ones
# listed verbatim in the task prompt's CAP_CONTEXT. Reconcile against the
# route's real output once both land -- this is a real open integration
# point, not a resolved one.
#
# Untyped domain (no pd:Type individuals): every action parameter and every
# problem object is a bare pd:Object, matching rdf-planning-domain.ttl's
# "a domain with no pd:Type instances compiles to an untyped
# (:requirements :strips) domain" note and the existing blocks_rdf_domain.ttl
# fixture's own style.

<urn:autofde-lab:ontology:platform-console-domain>
    a owl:Ontology ;
    dcterms:title "Platform console fabric-capability planning domain" ;
    dcterms:description "All ~30 platform-console fabric capabilities (CASTLE verbs, approval-gated actions, capability-intrinsic k8s/org/reservation/partner actions), encoded as pd:Action individuals conforming to ontology/rdf-planning-domain.ttl, so the existing compile_rdf_to_pddl_files -> pddl_engine.solve_to_plan_file -> project_plan_to_powl pipeline can plan over them unmodified." ;
    dcterms:created "2026-08-19"^^xsd:date .

ex:domain a pd:Domain ;
    pd:domainName "platform-console" ;
    pd:hasPredicate ex:pred-exists, ex:pred-components-inventoried, ex:pred-goals-inventoried, ex:pred-fortune5-requirements-listed, ex:pred-org-exists, ex:pred-approved, ex:pred-quota-hard-set, ex:pred-tier-set, ex:pred-retention-changed, ex:pred-remediation-suggested, ex:pred-export-updated, ex:pred-deployed, ex:pred-dr-failover-done, ex:pred-dsar-erasure-done, ex:pred-scheduled, ex:pred-frozen, ex:pred-freeze-override-approved, ex:pred-environment-promoted, ex:pred-quarantined, ex:pred-sla-credit-applied, ex:pred-namespace-exists, ex:pred-project-exists, ex:pred-environment-set, ex:pred-secret-exists, ex:pred-backup-exists, ex:pred-job-exists, ex:pred-restore-job-exists, ex:pred-replicas-patched, ex:pred-annotations-set, ex:pred-branding-set, ex:pred-region-set, ex:pred-custom-domain-set, ex:pred-sla-set, ex:pred-auto-remediate-set, ex:pred-reservation-active, ex:pred-partner-exists, ex:pred-partner-updated ;
    pd:hasAction ex:action-castle-inventory-components, ex:action-castle-inventory-goals, ex:action-castle-fortune5-requirements, ex:action-org-delete, ex:action-quota-override, ex:action-tier-downgrade, ex:action-backup-retention-change, ex:action-k8s-fault-remediate-suggest, ex:action-export-subscription-update, ex:action-dr-failover, ex:action-dsar-erasure, ex:action-castle-schedule, ex:action-freeze-override, ex:action-environment-promote, ex:action-deployment-quarantine, ex:action-sla-credit-apply, ex:action-patch-sla-credit-apply, ex:action-create-namespace, ex:action-create-project, ex:action-delete-project, ex:action-set-project-tier, ex:action-set-project-environment, ex:action-create-secret, ex:action-delete-secret, ex:action-create-backup-job, ex:action-create-restore-job, ex:action-delete-job, ex:action-patch-resource-quota-hard, ex:action-patch-deployment-replicas, ex:action-patch-namespace-annotations, ex:action-create-org, ex:action-delete-org, ex:action-set-org-branding, ex:action-set-org-region, ex:action-set-org-custom-domain, ex:action-set-org-sla, ex:action-set-org-auto-remediate-critical, ex:action-create-reservation, ex:action-cancel-reservation, ex:action-create-partner, ex:action-update-partner, ex:action-delete-partner, ex:action-deploy, ex:action-freeze .

