@prefix ga:   <https://gymact.dev/ns#> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct:  <http://purl.org/dc/terms/> .

# Minimal, hand-authored GymAct application profile fixture for
# test_profile_shacl.py. This is deliberately NOT generated by ggen -- it is
# small enough to reason about directly while the kernel is being built
# test-first.

ga:GymActProfile
    a prof:Profile ;
    dct:title "GymAct application profile (fixture)" ;
    prof:isProfileOf <https://www.w3.org/ns/prov-o> ;
    prof:hasResource ga:shapesResource .

ga:shapesResource
    a prof:ResourceDescriptor ;
    dct:title "GymAct SHACL shapes" ;
    prof:hasRole <https://www.w3.org/ns/dx/prof/role/validation> .

# A real episode instance, typed as a PROV activity per the profile.
ga:episode-fixture-1
    a prov:Activity ;
    dct:identifier "episode-fixture-1" .
