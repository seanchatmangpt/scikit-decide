{"schema_version":1,"name":"GymAct","semantic_rule":"acknowledgement != effect != verification != score","operations":[{%- for row in sparql_results %}{"code":{{ row["code"] | json_encode() }},"title":{{ row["title"] | json_encode() }},"phase":{{ row["phase"] | json_encode() }},"ordinal":{{ row["ordinal"] | json_encode() }},"consequence_class":{{ row["consequence"] | json_encode() }},"authority_mode":{{ row["authority_mode"] | json_encode() }},"replay_class":{{ row["replay_class"] | json_encode() }},"mainline":{{ row["mainline"] | json_encode() }}}{% if not loop.last %},{% endif %}{%- endfor %}]}
