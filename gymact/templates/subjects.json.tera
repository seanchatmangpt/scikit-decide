{"schema_version":1,"subjects":[{%- for row in sparql_results %}{"slug":{{ row["slug"] | json_encode() }},"title":{{ row["title"] | json_encode() }},"adapter_family":{{ row["adapter"] | json_encode() }},"profile":{{ row["profile_slug"] | json_encode() }},"interaction_model":{{ row["model"] | json_encode() }},"source_standing":{{ row["source_standing"] | json_encode() }},"local_safe_lexical":{{ row["local_safe"] | json_encode() }},"requires_authority_lexical":{{ row["requires_authority"] | json_encode() }},"vendor_slug":{{ row["vendor_slug"] | default(value="") | json_encode() }},"vendor_path":{{ row["vendor_path"] | default(value="") | json_encode() }},"pinned_revision":{{ row["pinned_revision"] | default(value="") | json_encode() }},"resolution_standing":{{ row["resolution_standing"] | default(value="UNRESOLVED") | json_encode() }},"smoke_standing":{{ row["smoke_standing"] | default(value="NOT_RUN") | json_encode() }}}{% if not loop.last %},{% endif %}{%- endfor %}]}
