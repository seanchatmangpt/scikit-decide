{"schema_version":1,"agent":"gymact","skills":[{%- for row in sparql_results %}{"id":"gymact.{{ row["code"] }}","name":{{ row["title"] | json_encode() }},"description":"GymAct {{ row["phase"] }} operation; consequence={{ row["consequence"] }}; authority={{ row["authority_mode"] }}","tags":["gymact",{{ row["phase"] | json_encode() }},{{ row["consequence"] | json_encode() }}],"inputModes":["application/json"],"outputModes":["application/json"]}{% if not loop.last %},{% endif %}{%- endfor %}]}
