{"schema_version":1,"catalog":[{%- for row in sparql_results %}{"kind":{{ row["kind"] | json_encode() }},"id":{{ row["id"] | json_encode() }},"aux1":{{ row["aux1"] | json_encode() }},"aux2":{{ row["aux2"] | json_encode() }}}{% if not loop.last %},{% endif %}{%- endfor %}],"execution_semantics":{"candidate_only":true,"planner_has_authority":false,"payoff_requires_execution_receipt":true}}
