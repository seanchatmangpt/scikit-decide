{"schema_version":1,"items":[{%- for row in sparql_results %}{"title":{{ row["title"] | json_encode() }},"action":{{ row["action"] | json_encode() }},"priority":{{ row["priority"] | json_encode() }},"owner":{{ row["owner"] | json_encode() }},"timing":{{ row["timing"] | json_encode() }},"path":{{ row["path"] | json_encode() }},"impact":{{ row["impact"] | json_encode() }},"effort":{{ row["effort"] | json_encode() }},"trigger":{{ row["trigger"] | json_encode() }},"falsifier":{{ row["falsifier"] | json_encode() }}}{% if not loop.last %},{% endif %}{%- endfor %}]}
