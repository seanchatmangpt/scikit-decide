{"schema_version":1,"server":"gymact","authority":"TRANSPORT_DOES_NOT_GRANT_AUTHORITY","tools":[{%- for row in sparql_results %}{"name":"gymact.{{ row["code"] }}","description":{{ row["title"] | json_encode() }},"annotations":{"phase":{{ row["phase"] | json_encode() }},"consequence_class":{{ row["consequence"] | json_encode() }},"authority_mode":{{ row["authority_mode"] | json_encode() }},"replay_class":{{ row["replay_class"] | json_encode() }}},"inputSchema":{"type":"object","properties":{"subject":{"type":"string"},"scenario_id":{"type":"string"},"episode_id":{"type":"string"},"payload":{"type":"object"},"authority_ref":{"type":"string"},"idempotency_key":{"type":"string"}},"required":["subject"]},"outputSchema":{"type":"object","properties":{"accepted":{"type":"boolean"},"standing":{"type":"string"},"episode_id":{"type":"string"},"observation":{"type":"object"},"effect":{"type":"object"},"score":{"type":["number","null"]},"receipt":{"type":"object"}},"required":["accepted","standing"]}}{% if not loop.last %},{% endif %}{%- endfor %}]}
