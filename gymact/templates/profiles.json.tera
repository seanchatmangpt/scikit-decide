{"schema_version":1,"profile_operation_bindings":[{%- for row in sparql_results %}{"profile":{{ row["profile_slug"] | json_encode() }},"title":{{ row["profile_title"] | json_encode() }},"interaction_model":{{ row["model"] | json_encode() }},"adapter_family":{{ row["adapter"] | json_encode() }},"operation":{{ row["operation_code"] | json_encode() }}}{% if not loop.last %},{% endif %}{%- endfor %}]}
