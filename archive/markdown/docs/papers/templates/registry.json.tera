{"schema_version":1,"authority":"SELECT_ONLY","benchmarks":[{%- for row in sparql_results %}{"slug":{{ row["slug"] | json_encode() }},"title":{{ row["title"] | json_encode() }},"adapter":{{ row["adapter"] | json_encode() }},"source_standing":{{ row["source_standing"] | json_encode() }},"vendor_slug":{{ row["vendor_slug"] | default(value="") | json_encode() }},"repository":{{ row["repo"] | default(value="") | json_encode() }},"path":{{ row["path"] | default(value="") | json_encode() }},"pinned_revision":{{ row["pinned_revision"] | default(value="") | json_encode() }},"resolution_standing":{{ row["resolution_standing"] | default(value="UNRESOLVED") | json_encode() }},"smoke_standing":{{ row["smoke_standing"] | default(value="NOT_RUN") | json_encode() }},"local_safe":{% if row["local_safe"] == "true" %}true{% else %}false{% endif %},"requires_authority":{% if row["source_standing"] == "BLOCKED:LIVE_CLOUD_AUTHORITY" %}true{% else %}false{% endif %}}{% if not loop.last %},{% endif %}{%- endfor %}]}
